---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
    active?: string;
}

const { active = '' } = Astro.props;

const links = [
    { href: '/', label: '首页' },
    { href: '/posts', label: '文章' },
    { href: '/projects', label: '项目' },
    { href: '/tools', label: '工具' },
    { href: '/links', label: '友链' },
    { href: '/about', label: '关于' },
];

// active 既支持调用方显式传 label，也在没传时按路径推断，
// 免得哪个页面漏传就整条导航都失去"当前位置"（§16 寻路）。
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (link: { href: string; label: string }) =>
    active === link.label ||
    (!active && (link.href === '/' ? path === '/' : path.startsWith(link.href)));
---

<header class="nav-shell" id="nav-shell">
    <div class="u-container nav-inner">
        <a class="logo" href="/" aria-label="OneSailTech — 返回首页">
            <img class="logo-img" src="/favicon.webp" alt="" width="30" height="30" />
            <span class="logo-text">OneSailTech</span>
        </a>

        <nav class="nav-links" aria-label="主导航">
            {links.map((link) => (
                <a
                    href={link.href}
                    class:list={['nav-link', { active: isCurrent(link) }]}
                    aria-current={isCurrent(link) ? 'page' : undefined}
                >{link.label}</a>
            ))}
        </nav>

        <div class="nav-actions">
            <ThemeToggle />
            <button
                class="menu-btn"
                id="menu-btn"
                type="button"
                aria-label="打开菜单"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <span class="bar bar-1"></span>
                <span class="bar bar-2"></span>
            </button>
        </div>
    </div>
</header>

{/* 同步执行：在首帧前就标记"汉堡菜单可用"，这样窄屏不会先闪一排链接再收起。
    脚本被禁用时这个 class 不会加上，链接行保持可横向滚动，导航仍然能用。 */}
<script is:inline>
    document.getElementById('nav-shell')?.classList.add('has-menu');
</script>

<div class="menu-scrim" id="menu-scrim" aria-hidden="true"></div>

<nav class="mobile-menu" id="mobile-menu" aria-label="主导航" inert>
    {links.map((link) => (
        <a
            href={link.href}
            class:list={['m-link', { active: isCurrent(link) }]}
            aria-current={isCurrent(link) ? 'page' : undefined}
        >{link.label}</a>
    ))}
</nav>

<script>
    const shell = document.getElementById('nav-shell');
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    const scrim = document.getElementById('menu-scrim');
    const root = document.documentElement;

    let open = false;

    function setOpen(next: boolean) {
        open = next;
        root.classList.toggle('is-nav-open', next);
        btn?.setAttribute('aria-expanded', String(next));
        btn?.setAttribute('aria-label', next ? '关闭菜单' : '打开菜单');
        // inert 让收起的菜单退出 Tab 顺序，但仍然可以做过渡动画（display:none 不行）
        if (next) menu?.removeAttribute('inert');
        else menu?.setAttribute('inert', '');
    }

    const focusFirstMenuItem = () => menu?.querySelector<HTMLElement>('a')?.focus();

    btn?.addEventListener('click', () => {
        const next = !open;
        setOpen(next);
        if (next) requestAnimationFrame(focusFirstMenuItem);
    });
    scrim?.addEventListener('click', () => {
        setOpen(false);
        btn?.focus();
    });

    // 点了菜单里的链接就收起：同页锚点跳转不会触发导航，菜单会一直挂着
    menu?.addEventListener('click', (e) => {
        if (e.target instanceof Element && e.target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && open) {
            setOpen(false);
            btn?.focus();
        }

        if (e.key === 'Tab' && open && btn && menu) {
            const focusable = [btn, ...menu.querySelectorAll<HTMLElement>('a')];
            const first = focusable[0];
            const last = focusable[focusable.length - 1];

            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        }
    });

    // §12 滚动边缘渐隐：只在内容真的滚到导航底下时才出现，不用常驻的 1px 分割线
    let ticking = false;
    function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
            shell?.classList.toggle('is-scrolled', window.scrollY > 4);
            ticking = false;
        });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // 视口放宽到桌面尺寸时收起菜单，否则 inert 状态会和布局对不上
    window.matchMedia('(min-width: 821px)').addEventListener('change', (e) => {
        if (e.matches && open) setOpen(false);
    });
</script>

<style>
    /* ---------- 顶栏：半透明材质，内容从底下穿过（§12） ---------- */

    .nav-shell {
        position: sticky;
        top: 0;
        z-index: var(--z-nav);
        background: var(--material-bg);
        backdrop-filter: var(--material-blur);
        -webkit-backdrop-filter: var(--material-blur);
    }

    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .nav-shell {
            background: var(--bg);
        }
    }

    /* 内容压到导航底下时才淡出一层渐变，代替常驻硬分割线 */
    .nav-shell::after {
        content: '';
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        height: var(--sp-5);
        pointer-events: none;
        background: linear-gradient(to bottom, var(--bg), transparent);
        opacity: 0;
        transition: opacity var(--dur-base) var(--ease-out);
    }

    .nav-shell.is-scrolled::after {
        opacity: 1;
    }

    .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-4);
        height: var(--nav-h);
    }

    /* ---------- 站点标识 ---------- */

    .logo {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-2);
        color: var(--text-1);
        /* §7：从自身左端缩放，视觉锚点不跑 */
        transform-origin: left center;
        transition: transform var(--dur-press) var(--ease-out),
            opacity var(--dur-fast) var(--ease-out);
    }

    .logo:hover {
        color: var(--text-1);
        opacity: 0.72;
    }

    .logo:active {
        transform: scale(0.96);
    }

    .logo-img {
        width: 30px;
        height: 30px;
        border-radius: var(--r-full);
        object-fit: cover;
    }

    .logo-text {
        font-family: var(--font-mono);
        font-size: var(--fs-label);
        letter-spacing: var(--ls-label);
        font-weight: 500;
    }

    /* ---------- 桌面链接 ---------- */

    .nav-links {
        display: flex;
        align-items: center;
        gap: var(--sp-1);
    }

    .nav-link {
        position: relative;
        padding: var(--sp-2) var(--sp-3);
        border-radius: var(--r-sm);
        color: var(--text-2);
        font-size: var(--fs-sm);
        font-weight: 500;
        letter-spacing: -0.005em;
        white-space: nowrap;
        transition: color var(--dur-fast) var(--ease-out),
            transform var(--dur-press) var(--ease-out);
    }

    .nav-link:hover {
        color: var(--text-1);
    }

    /* §1：按下的那一刻就给反馈，不等松手 */
    .nav-link:active {
        transform: scale(0.94);
    }

    .nav-link.active {
        color: var(--text-1);
    }

    /* 当前位置用一条信号色细线标记：比整块底色轻，落在半透明材质上也不糊 */
    .nav-link::after {
        content: '';
        position: absolute;
        left: var(--sp-3);
        right: var(--sp-3);
        bottom: 3px;
        height: 1.5px;
        border-radius: var(--r-full);
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: center;
        transition: transform var(--dur-base) var(--ease-spring);
    }

    .nav-link.active::after {
        transform: scaleX(1);
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: var(--sp-1);
    }

    /* ---------- 汉堡按钮：两根线转成叉 ---------- */

    .menu-btn {
        display: none;
        place-items: center;
        position: relative;
        width: 44px;
        height: 44px;
        border-radius: var(--r-full);
        color: var(--text-1);
        transition: background-color var(--dur-fast) var(--ease-out),
            transform var(--dur-press) var(--ease-out);
    }

    .menu-btn:hover {
        background: var(--surface-2);
    }

    .menu-btn:active {
        transform: scale(0.9);
    }

    .bar {
        position: absolute;
        left: 50%;
        top: calc(50% - 0.8px);
        width: 16px;
        height: 1.6px;
        margin-left: -8px;
        border-radius: var(--r-full);
        background: currentColor;
        transition: transform var(--dur-base) var(--ease-spring);
    }

    .bar-1 {
        transform: translateY(-3.5px);
    }

    .bar-2 {
        transform: translateY(3.5px);
    }

    :global(html.is-nav-open) .bar-1 {
        transform: rotate(45deg);
    }

    :global(html.is-nav-open) .bar-2 {
        transform: rotate(-45deg);
    }

    /* ---------- 遮罩：菜单是遮挡型任务，配一层压暗（§12） ---------- */

    .menu-scrim {
        position: fixed;
        inset: 0;
        z-index: calc(var(--z-nav) - 2);
        background: rgba(0, 0, 0, 0.28);
        opacity: 0;
        pointer-events: none;
        transition: opacity var(--dur-base) var(--ease-out);
    }

    :global(html.is-nav-open) .menu-scrim {
        opacity: 1;
        pointer-events: auto;
    }

    /* 菜单打开时锁住背景滚动。只在窄屏、只在菜单打开的这段时间生效，
       所以它对 sticky 的影响是瞬时的，不会像常驻的 overflow-x:hidden 那样造成漂移。 */
    :global(html.is-nav-open) {
        overflow: hidden;
    }

    /* ---------- 移动端菜单 ---------- */

    .mobile-menu {
        display: none;
    }

    @media (max-width: 820px) {
        /* 汉堡可用时才收掉链接行；脚本被禁用时保留下面的横向滚动兜底 */
        .nav-shell.has-menu .nav-links {
            display: none;
        }

        .nav-shell.has-menu .menu-btn {
            display: grid;
        }

        .nav-links {
            gap: 0;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .nav-links::-webkit-scrollbar {
            display: none;
        }

        .logo-text {
            display: none;
        }

        .mobile-menu {
            display: grid;
            position: fixed;
            top: calc(var(--nav-h) + var(--sp-1));
            right: var(--gutter);
            z-index: calc(var(--z-nav) - 1);
            min-width: 190px;
            padding: var(--sp-2);
            gap: 2px;
            border-radius: var(--r-lg);
            border: 1px solid var(--material-edge);
            background: var(--material-bg);
            backdrop-filter: var(--material-blur);
            -webkit-backdrop-filter: var(--material-blur);
            box-shadow: var(--shadow-3);
            /* §7：从汉堡按钮那侧展开，收起时走同一条路径回去 */
            transform-origin: top right;
            opacity: 0;
            transform: translateY(-6px) scale(0.96);
            pointer-events: none;
            transition: opacity var(--dur-fast) var(--ease-out),
                transform var(--dur-spring) var(--ease-spring);
        }

        :global(html.is-nav-open) .mobile-menu {
            opacity: 1;
            transform: none;
            pointer-events: auto;
        }
    }

    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .mobile-menu {
            background: var(--surface);
        }
    }

    .m-link {
        padding: var(--sp-3) var(--sp-4);
        border-radius: var(--r-md);
        color: var(--text-1);
        font-size: var(--fs-sm);
        font-weight: 500;
        transition: background-color var(--dur-fast) var(--ease-out),
            transform var(--dur-press) var(--ease-out);
    }

    .m-link:hover {
        background: var(--surface-2);
        color: var(--text-1);
    }

    .m-link:active {
        transform: scale(0.97);
    }

    .m-link.active {
        color: var(--accent);
    }

</style>
