---
// 文章卡片。首页与文章列表页共用，取代原先两处几乎相同的 .post-card。
import Tag from './Tag.astro';

interface Props {
    href: string;
    title: string;
    description?: string;
    date: Date;
    tags?: string[];
    index?: number;
    /** 头条版：标题与摘要各升一档，用在首页最新那一篇上。宽度由外面的网格决定。 */
    featured?: boolean;
}

const {
    href,
    title,
    description,
    date,
    tags = [],
    index = 0,
    featured = false,
} = Astro.props;

const display = date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
});
const iso = date.toISOString().slice(0, 10);
---

<a class:list={['u-card', 'card', { 'is-featured': featured }]} href={href} style={`--i:${index}`}>
    <div class="meta">
        <time class="u-label" datetime={iso}>{display}</time>
        {tags.map((tag) => <Tag>{tag}</Tag>)}
    </div>

    <h3>{title}</h3>
    {description && <p class="desc">{description}</p>}

    <span class="more">
        阅读全文
        <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
        </svg>
    </span>
</a>

<style>
    .card {
        gap: var(--sp-3);
        padding: var(--sp-5);
        color: var(--text-1);
    }

    .card:hover {
        color: var(--text-1);
    }

    .meta {
        display: flex;
        align-items: center;
        gap: var(--sp-2);
        flex-wrap: wrap;
    }

    h3 {
        font-size: var(--fs-h3);
        line-height: var(--lh-h3);
        letter-spacing: var(--ls-h3);
    }

    .desc {
        flex: 1;
        color: var(--text-2);
        font-size: var(--fs-sm);
        line-height: var(--lh-tight);
    }

    .more {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-1);
        margin-top: var(--sp-1);
        color: var(--accent);
        font-size: var(--fs-sm);
        font-weight: 500;
    }

    /* ---------- 头条版 ----------
       §6：层级靠字号与留白做，不靠再加一个"置顶"徽标。 */

    .card.is-featured {
        gap: var(--sp-4);
        padding: var(--sp-6);
    }

    .card.is-featured h3 {
        font-size: var(--fs-h2);
        line-height: var(--lh-h2);
        letter-spacing: var(--ls-h2);
    }

    .card.is-featured .desc {
        /* 卡片本身横跨整行，摘要不能跟着摊平，行长收回舒适区间 */
        max-width: var(--measure);
        color: var(--text-2);
        font-size: var(--fs-body);
        line-height: var(--lh-body);
    }

    @media (max-width: 700px) {
        .card.is-featured {
            padding: var(--sp-5);
        }

        .card.is-featured h3 {
            font-size: var(--fs-h3);
            line-height: var(--lh-h3);
            letter-spacing: var(--ls-h3);
        }

        .card.is-featured .desc {
            font-size: var(--fs-sm);
            line-height: var(--lh-tight);
        }
    }

    .arrow {
        width: 15px;
        height: 15px;
        /* §8：卡片被悬停时箭头先往前走一点，暗示点下去会去哪 */
        transition: transform var(--dur-base) var(--ease-spring);
    }

    @media (hover: hover) {
        .card:hover .arrow {
            transform: translateX(3px);
        }
    }

</style>
