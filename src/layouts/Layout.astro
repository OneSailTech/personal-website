---
import '../styles/tokens.css';
import '../styles/base.css';

export interface Props {
    title?: string;
    description?: string;
    image?: string;
}

const {
    title = 'XIE YIFAN',
    description = 'XIE YIFAN — 分享技术、设计与生活随笔',
    image = '/profile.webp',
} = Astro.props;

// Astro.site 在 astro.config.mjs 配置 site 后才有值（域名待补，见配置里的 TODO）。
// 未配置时退化为相对路径：本地与预览环境依然可用，只是分享卡片缺绝对地址。
const canonical = Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/webp" href="/favicon.webp" />

        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="generator" content="1Fan" />
        {canonical && <link rel="canonical" href={canonical} />}

        <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:locale" content="zh_CN" />
        {canonical && <meta property="og:url" content={canonical} />}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        {/* 防闪白：必须同步阻塞执行，在首帧绘制前就把主题定下来。
            不能加 async/defer，否则用户会先看到浅色再跳深色。 */}
        <script is:inline>
            try {
                const saved = localStorage.getItem('theme');
                if (saved === 'light' || saved === 'dark') {
                    document.documentElement.dataset.theme = saved;
                }
            } catch (e) {
                /* 隐私模式下 localStorage 不可用，跟随系统即可 */
            }
        </script>
    </head>
    <body>
        <a class="skip-link" href="#main">跳到主内容</a>
        <slot />

        <footer class="site-footer">
            <div class="u-container footer-inner">
                <p class="u-label">&copy; {new Date().getFullYear()} XIE YIFAN</p>
                <a class="u-label beian" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">
                    赣ICP备2023013465号-3
                </a>
            </div>
        </footer>
    </body>
</html>

<style>
    .site-footer {
        margin-top: var(--sp-10);
        padding: var(--sp-6) 0 var(--sp-7);
        border-top: 1px solid var(--hairline);
    }

    .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-4);
        flex-wrap: wrap;
    }

    .beian {
        color: var(--text-3);
        transition: color var(--dur-fast) var(--ease-out);
    }

    .beian:hover {
        color: var(--accent);
    }

    @media (max-width: 600px) {
        .footer-inner {
            flex-direction: column;
            justify-content: center;
            text-align: center;
            gap: var(--sp-2);
        }
    }
</style>
