---
import '../styles/tokens.css';
import '../styles/base.css';
import HeroFx from '../components/HeroFx.astro';

export interface Props {
    title?: string;
    description?: string;
    image?: string;
    /**
     * 页顶装饰带的档位。默认每一页都有，首页调大一档。
     * 'none' 留给确实不需要的页面（目前没有，但比硬编码判断路径可靠）。
     */
    fx?: 'hero' | 'page' | 'none';
}

const {
    title = 'OneSailTech',
    description = 'OneSailTech — 分享技术、设计与生活随笔',
    image = '/profile.webp',
    fx = 'page',
} = Astro.props;

// 正式域名来自 astro.config.mjs；本地开发时 Astro 仍会据此生成可发布的
// canonical 与分享图片绝对地址，避免预览地址被搜索引擎误收录。
const canonical = Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/webp" href="/favicon.webp" />

        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="generator" content="1Fan" />
        {canonical && <link rel="canonical" href={canonical} />}

        <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="OneSailTech" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:locale" content="zh_CN" />
        {canonical && <meta property="og:url" content={canonical} />}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        {/* 防闪白：必须同步阻塞执行，在首帧绘制前就把主题定下来。
            不能加 async/defer，否则用户会先看到浅色再跳深色。 */}
        <script is:inline>
            // 给不支持 CSS scroll-driven animations 的浏览器启用可靠的
            // IntersectionObserver 回退。放在首帧前标记，避免待入场元素先闪现。
            document.documentElement.classList.add('js');

            try {
                const saved = localStorage.getItem('theme');
                if (saved === 'light' || saved === 'dark') {
                    document.documentElement.dataset.theme = saved;
                }
            } catch (e) {
                /* 隐私模式下 localStorage 不可用，跟随系统即可 */
            }
        </script>
    </head>
    <body>
        <a class="skip-link" href="#main">跳到主内容</a>

        {fx !== 'none' && <HeroFx variant={fx} />}

        <slot />

        <footer class="site-footer">
            <div class="u-container footer-inner">
                <p class="u-label">&copy; {new Date().getFullYear()} XIE YIFAN</p>
                <a class="u-label beian" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">
                    赣ICP备2023013465号-3
                </a>
            </div>
        </footer>

        {/* 回到顶部。原先只有文章详情页有，长的列表页滚到底就得一路滚回去。 */}
        <button class="u-to-top" id="to-top" type="button" aria-label="返回顶部" title="返回顶部">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 19V6M6 12l6-6 6 6"></path>
            </svg>
        </button>

        <script>
            // 列表项真正进入视口后再做一次固定时长的入场。长区块不再随着自身
            // 高度被拖成漫长的半透明过程，卡片与章节也会使用同一套节奏。
            const revealItems = document.querySelectorAll('.u-stagger--scroll > *');

            if ('IntersectionObserver' in window) {
                const revealObserver = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) {
                            if (!entry.isIntersecting) continue;
                            entry.target.classList.add('is-revealed');
                            revealObserver.unobserve(entry.target);
                        }
                    },
                    { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
                );

                revealItems.forEach((item) => revealObserver.observe(item));
            } else {
                // 极旧浏览器至少保证内容可见，不把可读性押在动效 API 上。
                revealItems.forEach((item) => item.classList.add('is-revealed'));
            }

            // 滚过一屏才出现。滚动监听按帧节流。
            const toTop = document.getElementById('to-top');

            if (toTop) {
                let ticking = false;

                const sync = () => {
                    toTop.classList.toggle('is-visible', window.scrollY > 400);
                    ticking = false;
                };

                window.addEventListener(
                    'scroll',
                    () => {
                        if (ticking) return;
                        ticking = true;
                        requestAnimationFrame(sync);
                    },
                    { passive: true }
                );

                sync();

                // 这段滚动自己用 rAF 走，不用 scrollTo({ behavior: 'smooth' })：
                // 浏览器内置平滑滚动的时长是固定的，长文章里上万像素也在几百毫秒内
                // 走完，每帧位移远超可感知阈值，看上去就是"直接跳到顶"而不是滚上去
                // （§11：平滑取决于帧里装了什么，不只是帧率）。这里让时长随距离开方
                // 增长并封顶，末端的减速看得见，用户才知道自己落在了哪。
                let raf = 0;

                const stop = () => {
                    if (!raf) return;
                    cancelAnimationFrame(raf);
                    raf = 0;
                    release();
                };

                // §3：飞行途中用户一碰滚动就交还控制权，绝不把输入锁在动画后面
                const keys = new Set([
                    'ArrowUp',
                    'ArrowDown',
                    'PageUp',
                    'PageDown',
                    'Home',
                    'End',
                    ' ',
                ]);

                const onKey = (e: KeyboardEvent) => {
                    if (keys.has(e.key)) stop();
                };

                const grab = () => {
                    window.addEventListener('wheel', stop, { passive: true });
                    window.addEventListener('touchstart', stop, { passive: true });
                    window.addEventListener('keydown', onKey);
                };

                const release = () => {
                    window.removeEventListener('wheel', stop);
                    window.removeEventListener('touchstart', stop);
                    window.removeEventListener('keydown', onKey);
                };

                toTop.addEventListener('click', () => {
                    const from = window.scrollY;
                    if (from <= 0) return;

                    stop();

                    const ms = Math.min(880, 300 + Math.sqrt(from) * 12);
                    const t0 = performance.now();
                    grab();

                    const step = (now: number) => {
                        const t = Math.min(1, (now - t0) / ms);
                        // 与 --ease-out 同一个性格：起步快，末端稳稳收住
                        const eased = 1 - (1 - t) ** 3;
                        // 两参形式一定是瞬时的——平滑由上面这条曲线负责，
                        // 不能再让浏览器在每一帧上叠一次自己的平滑滚动。
                        window.scrollTo(0, from * (1 - eased));

                        if (t < 1) {
                            raf = requestAnimationFrame(step);
                        } else {
                            raf = 0;
                            release();
                        }
                    };

                    raf = requestAnimationFrame(step);
                });
            }
        </script>
    </body>
</html>

<style>
    .site-footer {
        position: relative;
        margin-top: var(--sp-10);
        padding: var(--sp-6) 0 var(--sp-7);
    }

    /* §12：与内容交接的地方用渐隐，不用一条通到底的硬线。
       两端淡出，中段最实，视觉上是"内容收束"而不是"被切断"。 */
    .site-footer::before {
        content: '';
        position: absolute;
        top: 0;
        left: var(--gutter);
        right: var(--gutter);
        height: 1px;
        background: linear-gradient(
            to right,
            transparent,
            var(--hairline-strong) 22%,
            var(--hairline-strong) 78%,
            transparent
        );
    }

    .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-4);
        flex-wrap: wrap;
    }

    .beian {
        color: var(--text-3);
        transition: color var(--dur-fast) var(--ease-out);
    }

    .beian:hover {
        color: var(--accent);
    }

    @media (max-width: 600px) {
        .footer-inner {
            flex-direction: column;
            justify-content: center;
            text-align: center;
            gap: var(--sp-2);
        }
    }
</style>
