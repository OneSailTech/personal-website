---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import ToolIcon from '../components/ToolIcon.astro';

const tools = [
    {
        name: '图片处理',
        description: '上传单/多张图片，离线转换为 PNG、JPG、WEBP、AVIF、BMP、GIF、ICO、TIFF、SVG 格式，或按百分比/像素调整尺寸、裁剪与留白',
        url: '/tools/image-tool',
        icon: 'image' as const,
    },
    {
        name: '视频格式转换',
        description: '上传单/多个视频，离线转换为 MP4、WEBM、AVI、MOV、MKV、GIF 等格式，或提取音频',
        url: '/tools/video-converter',
        icon: 'video' as const,
    },
    {
        name: 'Base64 编解码',
        description: '将文本或图片编码为 Base64，或将 Base64 解码为原文/图片',
        url: '/tools/base64',
        icon: 'base64' as const,
    },
    {
        name: '时间戳转换',
        description: 'Unix 时间戳与日期时间互相转换，支持一键复制结果',
        url: '/tools/timestamp',
        icon: 'time' as const,
    },
    {
        name: '颜色转换',
        description: 'HEX、RGB、HSL 颜色格式互相转换',
        url: '/tools/color-converter',
        icon: 'color' as const,
    },
    {
        name: 'Markdown 阅读器',
        description: '上传 Markdown 文件，使用文章同款样式即时预览',
        url: '/tools/markdown-reader',
        icon: 'markdown' as const,
    },
];
---

<Layout title="工具 — OneSailTech" description="实用的在线工具集合">
    <Nav active="工具" />

    <main id="main" class="u-container">
        <PageHeader
            label={`TOOLS · ${tools.length} 个`}
            title="实用工具"
            subtitle="全部在浏览器本地运行，文件不会上传到任何服务器"
        />

        <div class="grid u-stagger u-stagger--scroll">
            {tools.map((tool, i) => (
                <a class="u-card card" href={tool.url} style={`--i:${i}`}>
                    <span class="icon" aria-hidden="true">
                        <ToolIcon name={tool.icon} />
                    </span>

                    <div class="body">
                        <h3>{tool.name}</h3>
                        <p class="desc">{tool.description}</p>
                        <span class="more">
                            使用工具
                            <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
                            </svg>
                        </span>
                    </div>
                </a>
            ))}
        </div>
    </main>
</Layout>

<style>
    main {
        padding-bottom: var(--sp-9);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--sp-4);
    }

    /* 原先是居中卡片。改成图标在左、文字左对齐：
       六张卡片的标题会落在同一条竖线上，扫读比居中快。 */
    .card {
        flex-direction: row;
        gap: var(--sp-4);
        padding: var(--sp-5);
        color: var(--text-1);
    }

    .card:hover {
        color: var(--text-1);
    }

    .icon {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 44px;
        height: 44px;
        border-radius: var(--r-md);
        background: var(--surface-2);
        color: var(--text-2);
        transition: background-color var(--dur-fast) var(--ease-out),
            color var(--dur-fast) var(--ease-out);
    }

    .card:hover .icon {
        background: var(--accent-subtle);
        color: var(--accent);
    }

    .body {
        display: flex;
        flex-direction: column;
        gap: var(--sp-2);
        min-width: 0;
    }

    h3 {
        font-size: var(--fs-h3);
        line-height: var(--lh-h3);
        letter-spacing: var(--ls-h3);
    }

    .desc {
        flex: 1;
        color: var(--text-2);
        font-size: var(--fs-sm);
        line-height: var(--lh-tight);
    }

    .more {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-1);
        color: var(--accent);
        font-size: var(--fs-sm);
        font-weight: 500;
    }

    .arrow {
        width: 15px;
        height: 15px;
        transition: transform var(--dur-base) var(--ease-spring);
    }

    @media (hover: hover) {
        .card:hover .arrow {
            transform: translateX(3px);
        }
    }

    @media (max-width: 760px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }

</style>
