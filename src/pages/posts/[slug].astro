---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Tag from '../../components/Tag.astro';
import { countWords, readingMinutes } from '../../scripts/markdown';
import '../../styles/markdown.css';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const date = post.data.date;
const display = date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
});
const iso = date.toISOString().slice(0, 10);

// 字数与阅读时长：构建时算一次，用的是 Markdown 阅读器同一套统计
// （代码块不计入）。§6——补一点上下文反而让页面更好判断"要不要现在读"。
const words = countWords(post.body ?? '');
const minutes = readingMinutes(words);
---

<Layout title={`${post.data.title} — OneSailTech`} description={post.data.description}>
    <Nav active="文章" />

    {/* 阅读进度：纯 CSS 滚动驱动，不支持的浏览器就是一条不动的 0 宽度线 */}
    <div class="progress" aria-hidden="true"><span class="progress-bar"></span></div>

    <main id="main" class="u-container u-narrow">
        <header class="head u-stagger">
            <a class="back" href="/posts" style="--i:0">
                <svg class="chev" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9.5 4 5.5 8l4 4"></path>
                </svg>
                返回文章列表
            </a>

            <div class="meta" style="--i:1">
                <time class="u-label" datetime={iso}>{display}</time>
                <span class="u-label dot" aria-hidden="true">·</span>
                <span class="u-label">{words} 字</span>
                <span class="u-label dot" aria-hidden="true">·</span>
                <span class="u-label">约 {minutes} 分钟</span>
                {post.data.tags.map((tag) => <Tag>{tag}</Tag>)}
            </div>

            <h1 style="--i:2">{post.data.title}</h1>
            {post.data.description && <p class="desc" style="--i:3">{post.data.description}</p>}
        </header>

        <article class="sheet u-rise">
            <div class="md-rendered">
                <Content />
            </div>
        </article>

        <footer class="foot u-fade">
            <a class="u-btn u-btn--ghost" href="/posts">返回文章列表</a>
        </footer>
    </main>
</Layout>

<style>
    main {
        padding-block: var(--sp-7) var(--sp-9);
    }

    /* ---------- 阅读进度（§16 状态反馈） ---------- */

    .progress {
        position: fixed;
        inset: var(--nav-h) 0 auto 0;
        height: 2px;
        z-index: var(--z-float);
        pointer-events: none;
    }

    .progress-bar {
        display: block;
        width: 100%;
        height: 100%;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left center;
    }

    /* 必须写成长手：animation 简写会把 duration 归零，
       滚动时间轴就失去了 auto 时长，进度条会一直停在 0。 */
    @supports (animation-timeline: scroll()) {
        .progress-bar {
            animation-name: read-progress;
            animation-timing-function: linear;
            animation-duration: auto;
            animation-fill-mode: both;
            animation-timeline: scroll(root block);
        }
    }

    @keyframes read-progress {
        from {
            transform: scaleX(0);
        }
        to {
            transform: scaleX(1);
        }
    }

    /* ---------- 文章头 ---------- */

    .head {
        display: flex;
        flex-direction: column;
        gap: var(--sp-4);
        margin-bottom: var(--sp-6);
    }

    .back {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-1);
        align-self: flex-start;
        color: var(--text-2);
        font-size: var(--fs-sm);
    }

    .back:hover {
        color: var(--accent);
    }

    .chev {
        width: 15px;
        height: 15px;
        /* §8：往它要去的方向让一步 */
        transition: transform var(--dur-base) var(--ease-spring);
    }

    .back:hover .chev {
        transform: translateX(-3px);
    }

    .meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--sp-2);
    }

    /* 日期 · 字数 · 时长之间的分隔点：比再加一条竖线轻，也不抢标签的位置 */
    .dot {
        color: var(--hairline-strong);
    }

    .desc {
        color: var(--text-2);
        font-size: var(--fs-body);
    }

    /* ---------- 正文纸面 ----------
       正文交给 markdown.css，这里只负责它所在的那张纸。 */

    .sheet {
        padding: var(--sp-7);
        border: 1px solid var(--hairline);
        border-radius: var(--r-xl);
        background: var(--surface);
        animation-delay: 180ms;
    }

    .foot {
        margin-top: var(--sp-7);
        padding-top: var(--sp-6);
        border-top: 1px solid var(--hairline);
        text-align: center;
        animation-delay: 260ms;
    }

    @media (max-width: 900px) {
        main {
            padding-block: var(--sp-6) var(--sp-8);
        }

        .sheet {
            padding: var(--sp-5);
            border-radius: var(--r-lg);
        }
    }

    /* 手机上不再给正文套第二层“纸张边距”。页面栏距已经提供足够留白，
       展平后每行能多容纳约 3～4 个汉字，长文阅读明显更从容。 */
    @media (max-width: 600px) {
        .sheet {
            padding: 0;
            border: 0;
            border-radius: 0;
            background: transparent;
        }
    }

</style>

