---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="文章 — OneSailTech" description="OneSailTech 的技术文章与随笔">
    <Nav active="文章" />

    <main id="main" class="u-container">
        <PageHeader
            label={`WRITING · ${posts.length} 篇`}
            title="全部文章"
            subtitle="记录技术探索与思考的过程"
        />

        {posts.length > 0 ? (
            <div class="grid u-stagger u-stagger--scroll">
                {posts.map((post, i) => (
                    <PostCard
                        href={`/posts/${post.id}`}
                        title={post.data.title}
                        description={post.data.description}
                        date={post.data.date}
                        tags={post.data.tags}
                        index={i}
                        featured={i === 0}
                    />
                ))}
            </div>
        ) : (
            <p class="empty u-fade">暂无文章，敬请期待。</p>
        )}
    </main>
</Layout>

<style>
    main {
        padding-bottom: var(--sp-9);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--sp-4);
    }

    /* 最新那篇横跨整行，和首页同一套层级语言。
       卡片由 PostCard 渲染，拿不到本页的作用域属性，用 :global。 */
    .grid > :global(:first-child) {
        grid-column: 1 / -1;
    }

    .empty {
        padding-block: var(--sp-8);
        color: var(--text-3);
    }

    @media (max-width: 760px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }
</style>
