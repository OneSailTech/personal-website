---
import ToolShell from '../../components/ToolShell.astro';
import { VIDEO_FORMATS } from '../../scripts/video';
---

<ToolShell
    label="TOOL · VIDEO"
    title="视频格式转换"
    subtitle="用 FFmpeg 在你的浏览器里转码，视频不会上传到任何服务器。首次运行需要下载一次约 30 MB 的 FFmpeg，之后不再重复下载。"
    description="离线视频格式转换：MP4、WEBM、MOV、MKV、AVI、GIF，以及抽取 MP3 / WAV 音轨"
>
    <div class="t-drop" id="drop" role="button" tabindex="0" aria-label="选择或拖入视频">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <path d="M7 9l5-5 5 5M12 4v11"></path>
        </svg>
        <p class="t-drop-title">点击选择，或把视频拖进来</p>
        <p class="t-hint">支持 MP4 / WEBM / AVI / MOV / MKV / FLV / WMV 等，可多选</p>
        <input type="file" id="file-input" accept="video/*" multiple hidden />
    </div>

    <section class="t-panel" id="panel" hidden>
        <div class="t-field">
            <p class="t-legend">待转换 <span id="count">0</span> 个文件 · 共 <span id="total-size">0 B</span></p>
            <div class="t-files" id="files"></div>
        </div>

        <div class="t-field">
            <label for="format">目标格式</label>
            <select class="t-select" id="format">
                {VIDEO_FORMATS.map((format) => (
                    <option value={format.id}>{format.label}</option>
                ))}
            </select>
            <p class="t-hint" id="format-note"></p>
        </div>

        <div class="t-progress" id="progress" hidden>
            <div class="t-progress-bar" id="progress-bar"></div>
        </div>

        <div class="t-actions">
            <button class="u-btn u-btn--primary" id="convert" type="button">转换并下载</button>
            <button class="u-btn u-btn--ghost" id="cancel" type="button" hidden>取消</button>
            <button class="u-btn u-btn--ghost" id="clear" type="button">清空</button>
        </div>

        <p class="t-status" id="status" role="status" aria-live="polite"></p>

        <details class="t-log" id="log" hidden>
            <summary>FFmpeg 原始日志</summary>
            <pre class="t-log-body" id="log-body"></pre>
        </details>
    </section>
</ToolShell>

<script>
    import {
        VIDEO_FORMATS,
        buildArgs,
        getFFmpeg,
        isFFmpegReady,
        safeName,
        setHandlers,
        terminateFFmpeg,
        toBytes,
    } from '../../scripts/video';
    import { downloadBlob, formatSize, replaceExt } from '../../scripts/download';
    import { zipStore, type ZipEntry } from '../../scripts/zip';

    const drop = document.getElementById('drop') as HTMLElement;
    const input = document.getElementById('file-input') as HTMLInputElement;
    const panel = document.getElementById('panel') as HTMLElement;
    const filesBox = document.getElementById('files') as HTMLElement;
    const countLabel = document.getElementById('count') as HTMLElement;
    const totalLabel = document.getElementById('total-size') as HTMLElement;
    const formatSelect = document.getElementById('format') as HTMLSelectElement;
    const formatNote = document.getElementById('format-note') as HTMLElement;
    const progress = document.getElementById('progress') as HTMLElement;
    const progressBar = document.getElementById('progress-bar') as HTMLElement;
    const convertBtn = document.getElementById('convert') as HTMLButtonElement;
    const cancelBtn = document.getElementById('cancel') as HTMLButtonElement;
    const clearBtn = document.getElementById('clear') as HTMLButtonElement;
    const status = document.getElementById('status') as HTMLElement;
    const log = document.getElementById('log') as HTMLDetailsElement;
    const logBody = document.getElementById('log-body') as HTMLElement;

    let files: File[] = [];
    let busy = false;
    let cancelled = false;

    // §16：进行中 / 完成 / 提醒 / 错误 是四类反馈，不共用一句"处理中"
    type Kind = 'busy' | 'done' | 'warn' | 'error' | 'idle';

    function say(kind: Kind, text: string) {
        status.className = 't-status';
        if (kind !== 'idle') status.classList.add(`is-${kind}`);
        status.textContent = text;
    }

    // 日志只留最后 200 行：ffmpeg 一个长视频能刷出上万行，全留会把页面拖慢
    const lines: string[] = [];

    function pushLog(line: string) {
        lines.push(line);
        if (lines.length > 200) lines.splice(0, lines.length - 200);
        logBody.textContent = lines.join('\n');
        // 只在展开时滚动，收起时不必做无用的布局计算
        if (log.open) logBody.scrollTop = logBody.scrollHeight;
    }

    function currentFormat() {
        return VIDEO_FORMATS.find((item) => item.id === formatSelect.value) ?? VIDEO_FORMATS[0];
    }

    function syncFormat() {
        const format = currentFormat();
        formatNote.textContent = format.note ?? '';
        formatNote.hidden = !format.note;
    }

    function syncFiles() {
        countLabel.textContent = String(files.length);
        totalLabel.textContent = formatSize(files.reduce((sum, file) => sum + file.size, 0));
        panel.hidden = files.length === 0;

        filesBox.replaceChildren(
            ...files.map((file, index) => {
                const row = document.createElement('div');
                row.className = 't-file';

                const name = document.createElement('span');
                name.className = 't-file-name';
                // textContent 而不是 innerHTML：文件名里的 < > 不该被当成标签
                name.textContent = file.name;

                const size = document.createElement('span');
                size.className = 't-file-size';
                size.textContent = formatSize(file.size);

                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 't-file-remove';
                remove.setAttribute('aria-label', `移除 ${file.name}`);
                remove.innerHTML =
                    '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg>';
                remove.addEventListener('click', () => {
                    if (busy) return;
                    files.splice(index, 1);
                    syncFiles();
                    say('idle', '');
                });

                row.append(name, size, remove);
                return row;
            })
        );
    }

    function addFiles(list: FileList | null) {
        if (!list || busy) return;

        const incoming = Array.from(list).filter((file) => file.type.startsWith('video/'));
        const rejected = list.length - incoming.length;

        // 同一个文件拖两次只留一份
        const seen = new Set(files.map((file) => `${file.name}|${file.size}|${file.lastModified}`));
        let added = 0;

        for (const file of incoming) {
            const key = `${file.name}|${file.size}|${file.lastModified}`;
            if (seen.has(key)) continue;
            seen.add(key);
            files.push(file);
            added += 1;
        }

        syncFiles();

        if (rejected > 0) say('warn', `已忽略 ${rejected} 个非视频文件`);
        else if (added === 0 && incoming.length > 0) say('warn', '这些视频已经在列表里了');
        else say('idle', '');
    }

    drop.addEventListener('click', () => input.click());

    drop.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            input.click();
        }
    });

    drop.addEventListener('dragover', (event) => {
        event.preventDefault();
        drop.classList.add('is-over');
    });

    drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));

    drop.addEventListener('drop', (event) => {
        event.preventDefault();
        drop.classList.remove('is-over');
        addFiles(event.dataTransfer?.files ?? null);
    });

    input.addEventListener('change', () => {
        addFiles(input.files);
        // 清空 value，否则再选同一个文件不会触发 change
        input.value = '';
    });

    formatSelect.addEventListener('change', syncFormat);

    clearBtn.addEventListener('click', () => {
        if (busy) return;
        files = [];
        syncFiles();
        say('idle', '');
    });

    cancelBtn.addEventListener('click', () => {
        if (!busy) return;
        cancelled = true;
        // 转码是在 worker 里跑的同步循环，不终止它就停不下来
        terminateFFmpeg();
        say('warn', '正在停下…');
    });

    // 转码期间进度来自 ffmpeg 自己的回调，落在当前这一个文件的区间里
    let baseRatio = 0;
    let spanRatio = 1;

    function setProgress(ratio: number) {
        progress.hidden = false;
        progressBar.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
    }

    setHandlers(pushLog, (ratio) => {
        if (!busy) return;
        setProgress(baseRatio + Math.min(1, Math.max(0, ratio)) * spanRatio);
    });

    convertBtn.addEventListener('click', async () => {
        if (busy || files.length === 0) return;

        const format = currentFormat();
        busy = true;
        cancelled = false;
        convertBtn.disabled = true;
        clearBtn.disabled = true;
        cancelBtn.hidden = false;
        log.hidden = false;

        const results: ZipEntry[] = [];
        const failed: string[] = [];
        const total = files.length;

        baseRatio = 0;
        spanRatio = 1 / total;
        setProgress(0);

        try {
            say('busy', isFFmpegReady() ? '正在准备 FFmpeg…' : '首次运行，正在下载 FFmpeg（约 30 MB）…');
            const ffmpeg = await getFFmpeg();

            for (let i = 0; i < total; i += 1) {
                if (cancelled) break;

                const file = files[i];
                const inputName = safeName(file.name, i);
                const outputName = `out_${i}.${format.id}`;
                baseRatio = i / total;

                say('busy', `正在转换 ${i + 1} / ${total}：${file.name}`);

                try {
                    await ffmpeg.writeFile(inputName, new Uint8Array(await file.arrayBuffer()));
                    await ffmpeg.exec(buildArgs(inputName, outputName, format));

                    const data = await ffmpeg.readFile(outputName);
                    results.push({
                        name: replaceExt(file.name, format.id),
                        data: toBytes(data),
                    });

                    // 不删的话下一个文件会挤在同一块虚拟内存里，多文件时很快就爆
                    await ffmpeg.deleteFile(inputName);
                    await ffmpeg.deleteFile(outputName);
                } catch (error) {
                    failed.push(file.name);
                    pushLog(`[转换失败] ${file.name}：${error instanceof Error ? error.message : String(error)}`);
                    console.error(error);
                }

                setProgress((i + 1) / total);
            }
        } catch (error) {
            // 走到这里说明连 FFmpeg 都没加载起来，常见原因是资源读取失败或内存不足
            const message = error instanceof Error ? error.message : String(error);
            pushLog(`[加载失败] ${message}`);
            say('error', cancelled ? '已取消' : `FFmpeg 加载失败：${message.replace(/[。.]$/, '')}。请检查网络后重试。`);
            busy = false;
            convertBtn.disabled = false;
            clearBtn.disabled = false;
            cancelBtn.hidden = true;
            progress.hidden = true;
            return;
        }

        busy = false;
        convertBtn.disabled = false;
        clearBtn.disabled = false;
        cancelBtn.hidden = true;

        if (results.length === 0) {
            progress.hidden = true;
            say(
                cancelled ? 'warn' : 'error',
                cancelled ? '已取消，没有导出文件' : '一个都没转成功，展开下面的日志能看到 FFmpeg 的原话'
            );
            return;
        }

        if (results.length === 1) {
            const [only] = results;
            downloadBlob(new Blob([only.data], { type: format.mime }), only.name);
        } else {
            // 浏览器会拦截连续多次下载，所以多个文件打成一个 ZIP 再下
            const stamp = new Date().toISOString().slice(0, 10);
            downloadBlob(zipStore(results), `converted-${format.id}-${stamp}.zip`);
        }

        const suffix = results.length > 1 ? '（已打包为 ZIP）' : '';
        if (cancelled) {
            say('warn', `已取消，只导出了前 ${results.length} 个文件${suffix}`);
        } else if (failed.length > 0) {
            say('warn', `完成 ${results.length} 个，${failed.length} 个失败：${failed.join('、')}`);
        } else {
            say('done', `已导出 ${results.length} 个 ${format.label} 文件${suffix}`);
        }
    });

    syncFormat();
    syncFiles();
</script>
