---
import ToolShell from '../../components/ToolShell.astro';
---

<ToolShell
    label="TOOL · BASE64"
    title="Base64 编解码"
    subtitle="文本与图片的 Base64 互转。全部在你的浏览器里完成，内容不会上传到任何服务器。"
    description="Base64 编码与解码工具，支持文本和图片"
>
    <div class="t-segment" role="tablist" aria-label="编解码对象">
        <button id="tab-text" type="button" role="tab" aria-selected="true" aria-controls="mode-text">
            文本
        </button>
        <button id="tab-image" type="button" role="tab" aria-selected="false" aria-controls="mode-image">
            图片
        </button>
    </div>

    <section class="t-panel" id="mode-text" role="tabpanel" aria-labelledby="tab-text">
        <div class="t-row">
            <div class="t-field">
                <label for="input-text">原文 / BASE64</label>
                <textarea
                    class="t-textarea"
                    id="input-text"
                    placeholder="输入要编码的文本，或粘贴一段 Base64"
                ></textarea>
            </div>

            <div class="t-field">
                <label for="output-text">结果</label>
                <textarea
                    class="t-textarea"
                    id="output-text"
                    readonly
                    placeholder="结果会出现在这里"
                ></textarea>
            </div>
        </div>

        <div class="t-actions">
            <button class="u-btn u-btn--primary" id="encode" type="button">编码</button>
            <button class="u-btn u-btn--ghost" id="decode" type="button">解码</button>
            <button class="u-btn u-btn--ghost" id="copy-text" type="button">复制结果</button>
            <button class="u-btn u-btn--ghost" id="clear-text" type="button">清空</button>
        </div>

        <p class="t-status" id="status-text" role="status" aria-live="polite"></p>
        <p class="t-hint">解码能认折行的 Base64、URL 安全字母表（-_），尾部的 = 少了也会自动补齐。</p>
    </section>
    <div class="stack" id="mode-image" role="tabpanel" aria-labelledby="tab-image" hidden>
        <div class="t-drop" id="drop" role="button" tabindex="0" aria-label="选择或拖入图片">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2.5"></rect>
                <circle cx="8.5" cy="8.5" r="1.4"></circle>
                <path d="M21 15l-5-5L5 21"></path>
            </svg>
            <p class="t-drop-title">点击选择，或把图片拖进来</p>
            <p class="t-hint">选好就直接给出 data:image/... 形式的 Base64</p>
            <input type="file" id="image-input" accept="image/*" hidden />
        </div>

        <section class="t-panel" id="encode-panel" hidden>
            <div class="t-row">
                <div class="t-field">
                    <p class="t-legend">预览 · <span id="image-name">—</span></p>
                    <div class="t-preview">
                        <img id="image-preview" alt="待编码图片的预览" />
                    </div>
                </div>

                <div class="t-field">
                    <label for="image-base64">BASE64 结果</label>
                    <textarea class="t-textarea" id="image-base64" readonly></textarea>
                    <p class="t-hint" id="image-size"></p>
                </div>
            </div>

            <div class="t-actions">
                <button class="u-btn u-btn--primary" id="copy-image" type="button">复制 Base64</button>
                <button class="u-btn u-btn--ghost" id="clear-image" type="button">换一张</button>
            </div>

            <p class="t-status" id="status-image" role="status" aria-live="polite"></p>
        </section>

        <section class="t-panel">
            <div class="t-field">
                <label for="decode-input">BASE64 转回图片</label>
                <textarea
                    class="t-textarea"
                    id="decode-input"
                    placeholder="粘贴 data:image/... 或纯 Base64 字符串"
                ></textarea>
                <p class="t-hint">没有 data: 前缀时按 PNG 处理。</p>
            </div>

            <div class="t-actions">
                <button class="u-btn u-btn--primary" id="decode-image" type="button">解码为图片</button>
                <button class="u-btn u-btn--ghost" id="download-image" type="button" hidden>下载</button>
            </div>

            <div class="t-preview" id="decoded-wrap" hidden>
                <img id="decoded-image" alt="解码得到的图片" />
            </div>

            <p class="t-status" id="status-decode" role="status" aria-live="polite"></p>
        </section>
    </div>
</ToolShell>

<style>
    /* 图片模式里是三块并列的区域，间距跟 tool-body 保持同一档 */
    .stack {
        display: grid;
        gap: var(--sp-5);
    }
</style>
<script>
    import { copyText } from '../../scripts/copy';
    import { downloadBlob, formatSize } from '../../scripts/download';

    // §16：进行中 / 完成 / 提醒 / 错误 是四类反馈。三块区域各有自己的状态行，
    // 用同一个工厂产出，措辞和样式才不会各写一套。
    type Kind = 'busy' | 'done' | 'warn' | 'error' | 'idle';

    function reporter(el: HTMLElement) {
        return (kind: Kind, text: string) => {
            el.className = 't-status';
            if (kind !== 'idle') el.classList.add(`is-${kind}`);
            el.textContent = text;
        };
    }

    // ---------- 模式切换 ----------

    type Mode = 'text' | 'image';
    const MODES: Mode[] = ['text', 'image'];

    const tabs: Record<Mode, HTMLButtonElement> = {
        text: document.getElementById('tab-text') as HTMLButtonElement,
        image: document.getElementById('tab-image') as HTMLButtonElement,
    };

    const panes: Record<Mode, HTMLElement> = {
        text: document.getElementById('mode-text') as HTMLElement,
        image: document.getElementById('mode-image') as HTMLElement,
    };

    for (const mode of MODES) {
        tabs[mode].addEventListener('click', () => {
            for (const other of MODES) {
                tabs[other].setAttribute('aria-selected', String(other === mode));
                panes[other].hidden = other !== mode;
            }
        });
    }
    // ---------- 文本 ----------

    const inputText = document.getElementById('input-text') as HTMLTextAreaElement;
    const outputText = document.getElementById('output-text') as HTMLTextAreaElement;
    const sayText = reporter(document.getElementById('status-text') as HTMLElement);

    // 原实现走的是 btoa(unescape(encodeURIComponent(s)))：unescape 早已废弃，
    // 且对超出 BMP 的字符（emoji、部分生僻字）会算错。改成按 UTF-8 字节走。
    function toBase64(text: string): string {
        const bytes = new TextEncoder().encode(text);
        let binary = '';
        // 一次 fromCharCode 的实参个数有上限，长文本必须分块
        const CHUNK = 0x8000;
        for (let i = 0; i < bytes.length; i += CHUNK) {
            binary += String.fromCharCode(...bytes.subarray(i, i + CHUNK));
        }
        return btoa(binary);
    }

    /**
     * 解码时把常见的变体先归一化：
     * - 换行与空格：从终端或邮件头里复制来的 Base64 基本都是折行的；
     * - URL 安全字母表（RFC 4648 §5）：JWT、签名参数用的是 -_ 而不是 +/，atob 不认；
     * - 缺失的 = 补齐：很多生成器省略尾部填充，atob 会直接抛错。
     * 这些都不改变数据本身，是同一段内容的不同写法。
     */
    function normalizeBase64(value: string): string {
        const compact = value.replace(/[\s\r\n]+/g, '').replace(/-/g, '+').replace(/_/g, '/');
        const remainder = compact.length % 4;
        if (remainder === 0) return compact;
        // 余 1 是长度本身就不合法，补也补不出来，原样交给 atob 去报错
        return remainder === 1 ? compact : compact + '='.repeat(4 - remainder);
    }

    function fromBase64(value: string): string {
        const binary = atob(normalizeBase64(value));
        const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
        // fatal：不是合法 UTF-8 就抛错，而不是把一串乱码当结果交出去
        return new TextDecoder('utf-8', { fatal: true }).decode(bytes);
    }

    document.getElementById('encode')!.addEventListener('click', () => {
        if (!inputText.value) {
            sayText('warn', '左边还没有内容');
            return;
        }
        outputText.value = toBase64(inputText.value);
        sayText('done', `已编码 ${inputText.value.length} 个字符`);
    });

    document.getElementById('decode')!.addEventListener('click', () => {
        const value = inputText.value.trim();
        if (!value) {
            sayText('warn', '左边还没有内容');
            return;
        }
        try {
            outputText.value = fromBase64(value);
            sayText('done', '已解码');
        } catch {
            outputText.value = '';
            sayText('error', '这不是一段有效的 Base64 文本');
        }
    });
    document.getElementById('copy-text')!.addEventListener('click', async () => {
        if (!outputText.value) {
            sayText('warn', '还没有结果可以复制');
            return;
        }
        const ok = await copyText(outputText.value);
        sayText(ok ? 'done' : 'error', ok ? '已复制到剪贴板' : '复制失败，手动选中复制吧');
    });

    document.getElementById('clear-text')!.addEventListener('click', () => {
        inputText.value = '';
        outputText.value = '';
        sayText('idle', '');
        inputText.focus();
    });

    // ---------- 图片 · 编码 ----------

    const drop = document.getElementById('drop') as HTMLElement;
    const imageInput = document.getElementById('image-input') as HTMLInputElement;
    const encodePanel = document.getElementById('encode-panel') as HTMLElement;
    const imageName = document.getElementById('image-name') as HTMLElement;
    const imagePreview = document.getElementById('image-preview') as HTMLImageElement;
    const imageBase64 = document.getElementById('image-base64') as HTMLTextAreaElement;
    const imageSize = document.getElementById('image-size') as HTMLElement;
    const sayImage = reporter(document.getElementById('status-image') as HTMLElement);

    function takeImage(file: File | undefined) {
        if (!file) return;

        if (!file.type.startsWith('image/')) {
            sayImage('warn', '这不是图片文件');
            return;
        }

        const reader = new FileReader();

        reader.onload = () => {
            const dataUrl = String(reader.result);
            imagePreview.src = dataUrl;
            imageName.textContent = file.name;
            imageBase64.value = dataUrl;
            imageSize.textContent =
                `原图 ${formatSize(file.size)} → 文本 ${formatSize(dataUrl.length)}` +
                '，Base64 会比原文件大约三分之一。';
            drop.hidden = true;
            encodePanel.hidden = false;
            sayImage('done', '已编码，可以直接复制');
        };

        reader.onerror = () => sayImage('error', '这个文件读不出来');
        reader.readAsDataURL(file);
    }
    drop.addEventListener('click', () => imageInput.click());

    drop.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            imageInput.click();
        }
    });

    drop.addEventListener('dragover', (event) => {
        event.preventDefault();
        drop.classList.add('is-over');
    });

    drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));

    drop.addEventListener('drop', (event) => {
        event.preventDefault();
        drop.classList.remove('is-over');
        takeImage(event.dataTransfer?.files[0]);
    });

    imageInput.addEventListener('change', () => {
        takeImage(imageInput.files?.[0]);
        // 清空 value，否则再选同一个文件不会触发 change
        imageInput.value = '';
    });

    document.getElementById('copy-image')!.addEventListener('click', async () => {
        if (!imageBase64.value) return;
        const ok = await copyText(imageBase64.value);
        sayImage(ok ? 'done' : 'error', ok ? '已复制到剪贴板' : '复制失败，手动选中复制吧');
    });

    document.getElementById('clear-image')!.addEventListener('click', () => {
        imagePreview.removeAttribute('src');
        imageBase64.value = '';
        imageName.textContent = '—';
        imageSize.textContent = '';
        encodePanel.hidden = true;
        drop.hidden = false;
        sayImage('idle', '');
    });
    // ---------- 图片 · 解码 ----------

    const decodeInput = document.getElementById('decode-input') as HTMLTextAreaElement;
    const decodedWrap = document.getElementById('decoded-wrap') as HTMLElement;
    const decodedImage = document.getElementById('decoded-image') as HTMLImageElement;
    const downloadBtn = document.getElementById('download-image') as HTMLButtonElement;
    const sayDecode = reporter(document.getElementById('status-decode') as HTMLElement);

    document.getElementById('decode-image')!.addEventListener('click', () => {
        const raw = decodeInput.value.trim();
        if (!raw) {
            sayDecode('warn', '先粘贴一段 Base64');
            return;
        }

        const src = raw.startsWith('data:')
            ? raw
            : `data:image/png;base64,${raw.replace(/\s+/g, '')}`;

        // 先用一张离屏 Image 验，能解出来再挂到页面上。
        // 原实现直接把结果塞进可见的 <img>，失败时会留一个破图图标，还弹 alert。
        const probe = new Image();

        probe.onload = () => {
            decodedImage.src = src;
            decodedWrap.hidden = false;
            downloadBtn.hidden = false;
            sayDecode('done', `解码成功 · ${probe.naturalWidth} × ${probe.naturalHeight}`);
        };

        probe.onerror = () => {
            decodedWrap.hidden = true;
            downloadBtn.hidden = true;
            sayDecode('error', '解不出图片，检查一下 Base64 是否完整');
        };

        probe.src = src;
    });

    downloadBtn.addEventListener('click', async () => {
        if (!decodedImage.src) return;
        try {
            // data: URL 交给 fetch 转 Blob，扩展名跟着真实 MIME 走，
            // 不再像原来那样一律叫 decoded-image.png
            const blob = await fetch(decodedImage.src).then((res) => res.blob());
            const ext = (blob.type.split('/')[1] || 'png').replace(/\+xml$/, '');
            downloadBlob(blob, `decoded.${ext}`);
        } catch {
            sayDecode('error', '导出失败，可以右键图片另存为');
        }
    });
</script>
