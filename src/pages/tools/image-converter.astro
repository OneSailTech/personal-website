---
import ToolShell from '../../components/ToolShell.astro';
import { FORMATS } from '../../scripts/image';
---

<ToolShell
    label="TOOL · IMAGE"
    title="图片格式转换"
    subtitle="选好格式就能转，多张会自动打包成 ZIP。全部在你的浏览器里完成，图片不会上传到任何服务器。"
    description="离线图片格式转换：PNG、JPG、WEBP、AVIF、BMP、GIF、ICO、TIFF、SVG"
>
    <div class="t-drop" id="drop" role="button" tabindex="0" aria-label="选择或拖入图片">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <path d="M7 9l5-5 5 5M12 4v11"></path>
        </svg>
        <p class="t-drop-title">点击选择，或把图片拖进来</p>
        <p class="t-hint">支持 PNG / JPG / WEBP / AVIF / BMP / GIF / ICO / SVG 等，可多选</p>
        <input type="file" id="file-input" accept="image/*" multiple hidden />
    </div>

    <section class="t-panel" id="panel" hidden>
        <div class="t-field">
            <p class="t-legend">待转换 <span id="count">0</span> 个文件</p>
            <div class="t-files" id="files"></div>
        </div>

        <div class="t-row">
            <div class="t-field">
                <label for="format">目标格式</label>
                <select class="t-select" id="format">
                    {FORMATS.map((format) => (
                        <option value={format.mime}>{format.label}</option>
                    ))}
                </select>
                <p class="t-hint" id="format-note"></p>
            </div>

            <div class="t-field" id="quality-field" hidden>
                <label for="quality">质量 · <span id="quality-value">100%</span></label>
                <input class="t-range" type="range" id="quality" min="10" max="100" step="1" value="100" />
                <p class="t-hint">100% 即该格式的最高质量。无损格式没有这一项。</p>
            </div>
        </div>

        <div class="t-progress" id="progress" hidden>
            <div class="t-progress-bar" id="progress-bar"></div>
        </div>

        <div class="t-actions">
            <button class="u-btn u-btn--primary" id="convert" type="button">转换并下载</button>
            <button class="u-btn u-btn--ghost" id="cancel" type="button" hidden>取消</button>
            <button class="u-btn u-btn--ghost" id="clear" type="button">清空</button>
        </div>

        <p class="t-status" id="status" role="status" aria-live="polite"></p>
    </section>
</ToolShell>

<script>
    import { FORMATS, encodeImage, loadImage, supportsFormat } from '../../scripts/image';
    import { downloadBlob, formatSize, replaceExt } from '../../scripts/download';
    import { zipStore, type ZipEntry } from '../../scripts/zip';

    const drop = document.getElementById('drop') as HTMLElement;
    const input = document.getElementById('file-input') as HTMLInputElement;
    const panel = document.getElementById('panel') as HTMLElement;
    const filesBox = document.getElementById('files') as HTMLElement;
    const countLabel = document.getElementById('count') as HTMLElement;
    const formatSelect = document.getElementById('format') as HTMLSelectElement;
    const formatNote = document.getElementById('format-note') as HTMLElement;
    const qualityField = document.getElementById('quality-field') as HTMLElement;
    const quality = document.getElementById('quality') as HTMLInputElement;
    const qualityValue = document.getElementById('quality-value') as HTMLElement;
    const progress = document.getElementById('progress') as HTMLElement;
    const progressBar = document.getElementById('progress-bar') as HTMLElement;
    const convertBtn = document.getElementById('convert') as HTMLButtonElement;
    const cancelBtn = document.getElementById('cancel') as HTMLButtonElement;
    const clearBtn = document.getElementById('clear') as HTMLButtonElement;
    const status = document.getElementById('status') as HTMLElement;

    let files: File[] = [];
    let busy = false;
    let cancelled = false;

    // §16：四类反馈各有各的说法，不共用一句"处理中"
    type Kind = 'busy' | 'done' | 'warn' | 'error' | 'idle';

    function say(kind: Kind, text: string) {
        status.className = 't-status';
        if (kind !== 'idle') status.classList.add(`is-${kind}`);
        status.textContent = text;
    }

    // ---------- 运行时探测：浏览器不支持的格式直接禁掉，
    // 而不是让它静默导出一张改了后缀的 PNG ----------
    const supported = new Map<string, boolean>();

    for (const option of Array.from(formatSelect.options)) {
        const format = FORMATS.find((item) => item.mime === option.value);
        if (!format) continue;

        const ok = supportsFormat(format);
        supported.set(format.mime, ok);
        if (!ok) {
            option.disabled = true;
            option.textContent = `${format.label}（当前浏览器不支持导出）`;
        }
    }

    const firstUsable = Array.from(formatSelect.options).find((option) => !option.disabled);
    if (firstUsable) formatSelect.value = firstUsable.value;

    function currentFormat() {
        return FORMATS.find((item) => item.mime === formatSelect.value) ?? FORMATS[0];
    }

    function syncFormat() {
        const format = currentFormat();
        // 无损格式给质量滑块是骗人的——canvas 会直接忽略这个参数
        qualityField.hidden = !format.lossy;
        formatNote.textContent = format.note ?? '';
        formatNote.hidden = !format.note;
    }

    function syncFiles() {
        countLabel.textContent = String(files.length);
        panel.hidden = files.length === 0;

        filesBox.replaceChildren(
            ...files.map((file, index) => {
                const row = document.createElement('div');
                row.className = 't-file';

                const name = document.createElement('span');
                name.className = 't-file-name';
                // textContent 而不是 innerHTML：文件名里的 < > 不该被当成标签
                name.textContent = file.name;

                const size = document.createElement('span');
                size.className = 't-file-size';
                size.textContent = formatSize(file.size);

                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 't-file-remove';
                remove.setAttribute('aria-label', `移除 ${file.name}`);
                remove.innerHTML =
                    '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg>';
                remove.addEventListener('click', () => {
                    if (busy) return;
                    files.splice(index, 1);
                    syncFiles();
                    say('idle', '');
                });

                row.append(name, size, remove);
                return row;
            })
        );
    }

    function addFiles(list: FileList | null) {
        if (!list || busy) return;

        const incoming = Array.from(list).filter((file) => file.type.startsWith('image/'));
        const rejected = list.length - incoming.length;

        // 同一个文件拖两次只留一份
        const seen = new Set(files.map((file) => `${file.name}|${file.size}|${file.lastModified}`));
        let added = 0;

        for (const file of incoming) {
            const key = `${file.name}|${file.size}|${file.lastModified}`;
            if (seen.has(key)) continue;
            seen.add(key);
            files.push(file);
            added += 1;
        }

        syncFiles();

        if (rejected > 0) say('warn', `已忽略 ${rejected} 个非图片文件`);
        else if (added === 0 && incoming.length > 0) say('warn', '这些图片已经在列表里了');
        else say('idle', '');
    }

    drop.addEventListener('click', () => input.click());

    drop.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            input.click();
        }
    });

    drop.addEventListener('dragover', (event) => {
        event.preventDefault();
        drop.classList.add('is-over');
    });

    drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));

    drop.addEventListener('drop', (event) => {
        event.preventDefault();
        drop.classList.remove('is-over');
        addFiles(event.dataTransfer?.files ?? null);
    });

    input.addEventListener('change', () => {
        addFiles(input.files);
        // 清空 value，否则再选同一个文件不会触发 change
        input.value = '';
    });

    formatSelect.addEventListener('change', syncFormat);

    // §1：滑块拖动过程中数值就跟着走，不等松手
    quality.addEventListener('input', () => {
        qualityValue.textContent = `${quality.value}%`;
    });

    clearBtn.addEventListener('click', () => {
        if (busy) return;
        files = [];
        syncFiles();
        say('idle', '');
    });

    cancelBtn.addEventListener('click', () => {
        if (!busy) return;
        cancelled = true;
        say('warn', '正在停下…');
    });

    function setProgress(done: number, total: number) {
        progress.hidden = total < 1;
        progressBar.style.transform = `scaleX(${total ? done / total : 0})`;
    }

    // 每张之间让出一帧，浏览器才有机会把进度条画出来
    const nextFrame = () => new Promise((resolve) => requestAnimationFrame(resolve));

    convertBtn.addEventListener('click', async () => {
        if (busy || files.length === 0) return;

        const format = currentFormat();
        if (supported.get(format.mime) === false) {
            say('error', `当前浏览器无法导出 ${format.label}，换一个格式试试`);
            return;
        }

        busy = true;
        cancelled = false;
        convertBtn.disabled = true;
        clearBtn.disabled = true;
        cancelBtn.hidden = false;

        const value = Number(quality.value) / 100;
        const results: ZipEntry[] = [];
        const failed: string[] = [];
        const total = files.length;

        setProgress(0, total);

        for (let i = 0; i < total; i += 1) {
            if (cancelled) break;

            const file = files[i];
            say('busy', `正在转换 ${i + 1} / ${total}：${file.name}`);
            await nextFrame();

            try {
                const image = await loadImage(file);
                const blob = await encodeImage(image, format, value);
                results.push({
                    name: replaceExt(file.name, format.ext),
                    data: new Uint8Array(await blob.arrayBuffer()),
                });
            } catch (error) {
                failed.push(file.name);
                console.error(error);
            }

            setProgress(i + 1, total);
        }

        busy = false;
        convertBtn.disabled = false;
        clearBtn.disabled = false;
        cancelBtn.hidden = true;

        if (results.length === 0) {
            setProgress(0, 0);
            say(cancelled ? 'warn' : 'error', cancelled ? '已取消，没有导出文件' : '一张都没转成功，换个格式或换张图试试');
            return;
        }

        if (results.length === 1) {
            const [only] = results;
            downloadBlob(new Blob([only.data], { type: format.mime }), only.name);
        } else {
            // 浏览器会拦截连续多次下载，所以多个文件打成一个 ZIP 再下
            const stamp = new Date().toISOString().slice(0, 10);
            downloadBlob(zipStore(results), `converted-${format.ext}-${stamp}.zip`);
        }

        const suffix = results.length > 1 ? '（已打包为 ZIP）' : '';
        if (cancelled) {
            say('warn', `已取消，只导出了前 ${results.length} 个文件${suffix}`);
        } else if (failed.length > 0) {
            say('warn', `完成 ${results.length} 个，${failed.length} 个失败：${failed.join('、')}`);
        } else {
            say('done', `已导出 ${results.length} 个 ${format.label} 文件${suffix}`);
        }
    });

    syncFormat();
    syncFiles();
</script>

