---
import ToolShell from '../../components/ToolShell.astro';
---

<ToolShell
    label="TOOL · COLOR"
    title="颜色转换"
    subtitle="HEX、RGB、HSL 三种写法实时互转，改任意一栏另两栏立刻跟上。复制出来的就是可以直接粘进 CSS 的形式。"
    description="HEX、RGB、HSL 颜色格式互相转换"
>
    <section class="t-panel">
        <div class="swatch" id="swatch">
            <span class="swatch-value" id="swatch-value">#2563EB</span>
        </div>

        <div class="t-row">
            <div class="t-field">
                <label for="hex">HEX</label>
                <input
                    class="t-input"
                    id="hex"
                    type="text"
                    spellcheck="false"
                    autocomplete="off"
                    placeholder="#2563eb"
                />
            </div>

            <div class="t-field">
                <label for="rgb">RGB</label>
                <input
                    class="t-input"
                    id="rgb"
                    type="text"
                    spellcheck="false"
                    autocomplete="off"
                    placeholder="rgb(37, 99, 235)"
                />
            </div>

            <div class="t-field">
                <label for="hsl">HSL</label>
                <input
                    class="t-input"
                    id="hsl"
                    type="text"
                    spellcheck="false"
                    autocomplete="off"
                    placeholder="hsl(217, 84%, 53%)"
                />
            </div>
        </div>
        <div class="t-field picker-field">
            <label for="picker">取色器</label>
            <input class="t-color" type="color" id="picker" value="#2563eb" />
            <p class="t-hint">三栏都能容错：带不带 # 、带不带 rgb() 都认。</p>
        </div>

        <div class="t-actions">
            <button class="u-btn u-btn--ghost" id="copy-hex" type="button">复制 HEX</button>
            <button class="u-btn u-btn--ghost" id="copy-rgb" type="button">复制 RGB</button>
            <button class="u-btn u-btn--ghost" id="copy-hsl" type="button">复制 HSL</button>
        </div>

        <p class="t-status" id="status" role="status" aria-live="polite"></p>
    </section>
</ToolShell>

<style>
    .swatch {
        display: grid;
        place-items: center;
        min-height: 8.5rem;
        border: 1px solid var(--hairline);
        border-radius: var(--r-md);
        /* 换色时过一下渡，不要硬跳 */
        transition: background-color var(--dur-base) var(--ease-out);
    }

    .swatch-value {
        font-family: var(--font-mono);
        font-size: var(--fs-h3);
        letter-spacing: 0.05em;
        font-weight: 500;
    }

    /* 叠字颜色跟着底色的相对亮度走：浅底用黑字，深底用白字 */
    .swatch[data-tone='dark'] .swatch-value {
        color: rgba(0, 0, 0, 0.78);
    }

    .swatch[data-tone='light'] .swatch-value {
        color: rgba(255, 255, 255, 0.95);
    }

    /* 取色器是个 42px 高的色块，铺满一整行会显得没道理 */
    .picker-field {
        max-width: 13rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .swatch {
            transition: none;
        }
    }
</style>
<script>
    import { copyText } from '../../scripts/copy';

    interface RGB {
        r: number;
        g: number;
        b: number;
    }

    interface HSL {
        h: number;
        s: number;
        l: number;
    }

    const round = (n: number) => Math.round(n);
    const clamp = (n: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, n));
    const byte = (n: number) => clamp(round(n), 0, 255);

    // ---------- 数值互转 ----------

    function toHex({ r, g, b }: RGB): string {
        return `#${[r, g, b].map((v) => v.toString(16).padStart(2, '0')).join('').toUpperCase()}`;
    }

    function toRgbText({ r, g, b }: RGB): string {
        return `rgb(${r}, ${g}, ${b})`;
    }

    function toHslText({ h, s, l }: HSL): string {
        return `hsl(${h}, ${s}%, ${l}%)`;
    }

    function rgbToHsl({ r, g, b }: RGB): HSL {
        const rn = r / 255;
        const gn = g / 255;
        const bn = b / 255;
        const max = Math.max(rn, gn, bn);
        const min = Math.min(rn, gn, bn);
        const span = max - min;
        const l = (max + min) / 2;

        let h = 0;
        if (span !== 0) {
            if (max === rn) h = ((gn - bn) / span) % 6;
            else if (max === gn) h = (bn - rn) / span + 2;
            else h = (rn - gn) / span + 4;
            h *= 60;
            if (h < 0) h += 360;
        }

        // 灰色的饱和度按定义就是 0，不必再算
        const s = span === 0 ? 0 : span / (1 - Math.abs(2 * l - 1));
        return { h: round(h) % 360, s: round(s * 100), l: round(l * 100) };
    }

    function hslToRgb({ h, s, l }: HSL): RGB {
        const hn = ((h % 360) + 360) % 360;
        const sn = clamp(s, 0, 100) / 100;
        const ln = clamp(l, 0, 100) / 100;

        const c = (1 - Math.abs(2 * ln - 1)) * sn;
        const x = c * (1 - Math.abs(((hn / 60) % 2) - 1));
        const m = ln - c / 2;

        const sector = Math.floor(hn / 60) % 6;
        const table: [number, number, number][] = [
            [c, x, 0],
            [x, c, 0],
            [0, c, x],
            [0, x, c],
            [x, 0, c],
            [c, 0, x],
        ];
        const [r, g, b] = table[sector];
        return { r: byte((r + m) * 255), g: byte((g + m) * 255), b: byte((b + m) * 255) };
    }

    /** 相对亮度（WCAG）。用它决定色块上的字用黑还是白，而不是简单看 R+G+B。 */
    function luminance({ r, g, b }: RGB): number {
        const channel = (v: number) => {
            const n = v / 255;
            return n <= 0.03928 ? n / 12.92 : ((n + 0.055) / 1.055) ** 2.4;
        };
        return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b);
    }

    // ---------- 解析：三栏都尽量容错 ----------

    function parseHex(text: string): RGB | null {
        const raw = text.trim().replace(/^#/, '');
        if (!/^[0-9a-f]+$/i.test(raw)) return null;

        let hex = raw;
        // #abc 与 #abcf 都是简写，各位翻倍展开；带 alpha 的第四位直接丢掉
        if (hex.length === 3 || hex.length === 4) {
            hex = [...hex.slice(0, 3)].map((c) => c + c).join('');
        } else if (hex.length === 8) {
            hex = hex.slice(0, 6);
        }
        if (hex.length !== 6) return null;

        return {
            r: parseInt(hex.slice(0, 2), 16),
            g: parseInt(hex.slice(2, 4), 16),
            b: parseInt(hex.slice(4, 6), 16),
        };
    }

    /** 抓出文本里的数字，并记下它后面有没有百分号 */
    function numbers(text: string): { value: number; percent: boolean }[] {
        return [...text.matchAll(/(-?\d*\.?\d+)\s*(%?)/g)]
            .map((m) => ({ value: parseFloat(m[1]), percent: m[2] === '%' }))
            .filter((n) => Number.isFinite(n.value));
    }

    function parseRgb(text: string): RGB | null {
        const parts = numbers(text);
        if (parts.length < 3) return null;
        // rgb() 里三个通道也允许写成百分比
        const [r, g, b] = parts.slice(0, 3).map((n) => byte(n.percent ? n.value * 2.55 : n.value));
        return { r, g, b };
    }

    function parseHsl(text: string): RGB | null {
        const parts = numbers(text);
        if (parts.length < 3) return null;
        return hslToRgb({ h: parts[0].value, s: parts[1].value, l: parts[2].value });
    }

    // ---------- 页面 ----------

    const swatch = document.getElementById('swatch') as HTMLElement;
    const swatchValue = document.getElementById('swatch-value') as HTMLElement;
    const hexField = document.getElementById('hex') as HTMLInputElement;
    const rgbField = document.getElementById('rgb') as HTMLInputElement;
    const hslField = document.getElementById('hsl') as HTMLInputElement;
    const picker = document.getElementById('picker') as HTMLInputElement;
    const statusEl = document.getElementById('status') as HTMLElement;

    type Kind = 'done' | 'warn' | 'error' | 'idle';

    function say(kind: Kind, text: string) {
        statusEl.className = 't-status';
        if (kind !== 'idle') statusEl.classList.add(`is-${kind}`);
        statusEl.textContent = text;
    }

    let current: RGB = { r: 37, g: 99, b: 235 };

    /**
     * 把当前颜色写回界面。source 是用户正在输入的那一栏——不回写它，
     * 否则光标会被顶到末尾，"#25" 还没打完就被补成 "#252525"。
     */
    function render(color: RGB, source?: HTMLInputElement) {
        current = color;
        const hex = toHex(color);
        const hsl = rgbToHsl(color);

        if (source !== hexField) hexField.value = hex;
        if (source !== rgbField) rgbField.value = toRgbText(color);
        if (source !== hslField) hslField.value = toHslText(hsl);

        picker.value = hex.toLowerCase();
        swatch.style.backgroundColor = hex;
        swatchValue.textContent = hex;
        // 亮底配深字，暗底配浅字；0.4 是实测下来两边都还舒服的分界
        swatch.dataset.tone = luminance(color) > 0.4 ? 'dark' : 'light';
    }

    function wire(field: HTMLInputElement, parse: (text: string) => RGB | null, name: string) {
        field.addEventListener('input', () => {
            const text = field.value.trim();
            if (!text) {
                say('idle', '');
                return;
            }
            const parsed = parse(text);
            if (!parsed) {
                say('warn', `${name} 还读不出来，继续输入`);
                return;
            }
            say('idle', '');
            render(parsed, field);
        });

        // 失焦时把这一栏也补成规范写法：输入期间不动它，离开了就该整齐
        field.addEventListener('blur', () => {
            if (field.value.trim()) render(current);
        });
    }

    wire(hexField, parseHex, 'HEX');
    wire(rgbField, parseRgb, 'RGB');
    wire(hslField, parseHsl, 'HSL');

    // type=color 是连续拖动的，input 事件跟着拖，反馈才是实时的（§1）
    picker.addEventListener('input', () => {
        const parsed = parseHex(picker.value);
        if (parsed) {
            render(parsed);
            say('idle', '');
        }
    });

    const copies: [string, () => string][] = [
        ['copy-hex', () => toHex(current)],
        ['copy-rgb', () => toRgbText(current)],
        ['copy-hsl', () => toHslText(rgbToHsl(current))],
    ];

    for (const [id, get] of copies) {
        document.getElementById(id)!.addEventListener('click', async () => {
            const value = get();
            const ok = await copyText(value);
            say(ok ? 'done' : 'error', ok ? `已复制 ${value}` : '复制失败，手动选中复制吧');
        });
    }

    render(current);
</script>
