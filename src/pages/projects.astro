---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import Tag from '../components/Tag.astro';

const projects = [
    {
        name: 'GanJunMi-Server',
        description: '基于 Spring Boot 2.7 的培训管理后端服务，提供微信 OAuth 登录、JWT 认证、证书管理、发票管理等 RESTful API。',
        url: 'https://github.com/XieYifan1201/GanJunMi-Server',
        tags: ['Spring Boot', 'MyBatis', 'Java', 'JWT'],
    },
    {
        name: 'GanJunMi-App',
        description: '基于 uni-app 的培训管理移动端应用，支持微信授权登录、在线报名、证书扫码查询，一套代码多端运行。',
        url: 'https://github.com/XieYifan1201/GanJunMi-App',
        tags: ['uni-app', 'Vue 3', '微信小程序', '跨端开发'],
    },
    {
        name: 'GanJunMi-Admin',
        description: '基于 Vue 2 的培训机构一站式后台管理系统，涵盖培训管理、学员管理、证书生成打印等全流程功能。',
        url: 'https://github.com/XieYifan1201/GanJunMi-Admin',
        tags: ['Vue 2', 'Element UI', 'Canvas', 'ECharts'],
    },
    {
        name: 'SailChat',
        description: '基于 Flutter 开发的即时通讯应用，支持消息收发、联系人管理等功能，注重用户体验与界面设计。',
        url: 'https://github.com/XieYifan1201/SailChat',
        tags: ['Flutter', 'Dart', 'IM'],
    },
    {
        name: 'SailChat-Server',
        description: 'SailChat 的后端服务，基于 Spring Boot 构建，提供 RESTful API 与 WebSocket 支持。',
        url: 'https://github.com/XieYifan1201/SailChat-Server',
        tags: ['Spring Boot', 'Java', 'WebSocket'],
    },
    {
        name: 'Sail-Link',
        description: 'Sail Link 是一款基于 Flutter 开发的局域网点对点通讯工具。',
        url: 'https://github.com/OneSailTech/Sail-Link',
        tags: ['Flutter', 'dart', 'UDP'],
    },
];

// 原先在模板里直接 projects.reverse()，那是原地改数组；
// 复制一份再倒序，顺序结果一样但不改动源数据。
const ordered = [...projects].reverse();
---

<Layout title="项目 — OneSailTech" description="OneSailTech 的开源项目与作品">
    <Nav active="项目" />

    <main id="main" class="u-container">
        <PageHeader
            label={`WORK · ${ordered.length} 个`}
            title="我的项目"
            subtitle="探索、创造与分享"
        />

        <div class="grid u-stagger u-stagger--scroll">
            {ordered.map((project, i) => (
                <a
                    class="u-card card"
                    href={project.url}
                    target="_blank"
                    rel="noopener"
                    style={`--i:${i}`}
                >
                    <div class="head">
                        <span class="u-label num">{String(i + 1).padStart(2, '0')}</span>
                        <h3>{project.name}</h3>
                    </div>

                    <p class="desc">{project.description}</p>

                    <div class="tags">
                        {project.tags.map((tag) => <Tag variant="quiet">{tag}</Tag>)}
                    </div>

                    <span class="more">
                        在 GitHub 查看
                        <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5.5 10.5 10.5 5.5M6 5.5h4.5V10"></path>
                        </svg>
                    </span>
                </a>
            ))}
        </div>
    </main>
</Layout>

<style>
    main {
        padding-bottom: var(--sp-9);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--sp-4);
    }

    .card {
        gap: var(--sp-3);
        padding: var(--sp-5);
        color: var(--text-1);
    }

    .card:hover {
        color: var(--text-1);
    }

    .head {
        display: flex;
        align-items: baseline;
        gap: var(--sp-3);
    }

    .num {
        flex-shrink: 0;
        color: var(--accent);
    }

    h3 {
        min-width: 0;
        font-family: var(--font-mono);
        font-size: var(--fs-h3);
        line-height: var(--lh-h3);
        letter-spacing: var(--ls-h3);
        overflow-wrap: anywhere;
    }

    .desc {
        flex: 1;
        color: var(--text-2);
        font-size: var(--fs-sm);
        line-height: var(--lh-tight);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-2);
    }

    .more {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-1);
        margin-top: var(--sp-1);
        color: var(--accent);
        font-size: var(--fs-sm);
        font-weight: 500;
    }

    .arrow {
        width: 15px;
        height: 15px;
        /* §8：外链的箭头朝右上，悬停时就往右上让一步 */
        transition: transform var(--dur-base) var(--ease-spring);
    }

    @media (hover: hover) {
        .card:hover .arrow {
            transform: translate(2px, -2px);
        }
    }

    @media (max-width: 760px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }

</style>
