---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="XIE YIFAN" description="XIE YIFAN — 分享技术、设计与生活随笔">
    <Nav active="首页" />

    <main id="main" class="u-container">
        <section class="hero u-stagger">
            <p class="u-label" style="--i:0">FULL-STACK DEVELOPER · CHINA</p>
            <h1 style="--i:1">XIE YIFAN</h1>
            <p class="subtitle" style="--i:2">
                在这里分享关于 <strong>技术分享</strong>、<strong>设计思维</strong> 以及 <strong>生活随笔</strong>。
                追求代码的优雅，也热爱生活的细腻。
            </p>
            <div class="actions" style="--i:3">
                <a class="u-btn u-btn--primary" href="/posts">浏览文章</a>
                <a class="u-btn u-btn--ghost" href="https://github.com/XieYifan1201" target="_blank" rel="noopener">
                    Github
                </a>
            </div>
        </section>

        {posts.length > 0 && (
            <section class="posts">
                <div class="u-section-head">
                    <span class="idx">01</span>
                    <h2 class="title">最新文章 / LATEST POSTS</h2>
                </div>

                <div class="posts-grid u-stagger">
                    {posts.map((post, i) => (
                        <PostCard
                            href={`/posts/${post.id}`}
                            title={post.data.title}
                            description={post.data.description}
                            date={post.data.date}
                            tags={post.data.tags}
                            index={i}
                        />
                    ))}
                </div>
            </section>
        )}
    </main>
</Layout>

<style>
    .hero {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        min-height: min(68svh, 560px);
        padding-block: var(--sp-8);
    }

    .hero h1 {
        margin-top: var(--sp-3);
        font-size: var(--fs-display);
        line-height: var(--lh-display);
        letter-spacing: var(--ls-display);
    }

    .subtitle {
        max-width: var(--w-narrow);
        margin-top: var(--sp-4);
        color: var(--text-2);
        font-size: var(--fs-body);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-3);
        margin-top: var(--sp-6);
    }

    .posts {
        padding-bottom: var(--sp-9);
    }

    .posts-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--sp-4);
    }

    @media (max-width: 760px) {
        .posts-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
